node_modules/
dist/

# No video is committed. The clips live in Google Drive, which is the whole point
# of the storage layer, and any clip on hand locally is someone else's content —
# so it stays local rather than being published here. Drop your own file into
# `app/public/` or `mockup/public/` to have something to play against.
*.mp4

# The one exception (#33): the demo clip is Thomas dancing — his own footage,
# silent, stripped of location metadata, and published on purpose so a visitor
# with no Google account can try the player. It lives under `src/`, not
# `public/`, and is bundled by import. Named exactly: committing is the only
# way a clip reaches the live site, and no other video gets in this way.
!app/src/demo/demo-clip.mp4

# The Claude Code working directory. Only its skills and agents are tracked, and
# they came in from the public snapshot thomashoddinott/claude-code-skills-27092026.
# Worktrees, local settings, commands and hooks stay out: no earlier version of
# this tooling has ever been committed here.
.claude/*
!.claude/skills/
!.claude/agents/

# Scratch planning notes: they live inside a worktree and die with it.
PLAN.md

.env
.env.local
.env.*.local
.DS_Store
*.log
